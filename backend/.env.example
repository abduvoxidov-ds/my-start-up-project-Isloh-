# ISLOH backend — muhit o'zgaruvchilari namunasi
# Nusxa oling:  cp backend/.env.example backend/.env
# `backend/.env` .gitignore da — maxfiy qiymatlar hech qachon commit qilinmaydi.

# --- Django ----------------------------------------------------------------
# Ishlab chiqarishda albatta yangisini yarating:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=dev-only-not-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Ma'lumotlar bazasi ----------------------------------------------------
# backend/docker-compose.yml dagi standart qiymatlarga mos keladi.
# Portni compose faylida o'zgartirsangiz, bu yerda ham o'zgartiring.
DATABASE_URL=postgres://isloh:isloh@localhost:5432/isloh

# docker-compose ham shu qiymatlarni o'qiydi
POSTGRES_DB=isloh
POSTGRES_USER=isloh
POSTGRES_PASSWORD=isloh

# --- Auth ------------------------------------------------------------------
# js/api.js shartnomasi: access token javob tanasida, refresh — httpOnly
# cookie (credentials: 'include'). docs/BACKEND-PLAN.md §0.3
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
JWT_REFRESH_COOKIE_NAME=isloh_refresh
# Prod'da True (HTTPS talab qiladi)
JWT_REFRESH_COOKIE_SECURE=False

# --- Keyingi sprintlar (hozircha ishlatilmaydi) -----------------------------
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# PAYMENT_PROVIDER=
# PAYMENT_SECRET=
# REDIS_URL=redis://localhost:6379/0
