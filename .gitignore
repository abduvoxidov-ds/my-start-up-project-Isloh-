# --- Backend (Python / Django) --------------------------------------------
backend/.venv/
backend/**/__pycache__/
backend/**/*.py[cod]

# Maxfiy sozlamalar — SECRET_KEY, DATABASE_URL, JWT, S3, to'lov kalitlari.
# Namuna sifatida faqat backend/.env.example versiyalanadi.
backend/.env
backend/.env.*
!backend/.env.example

# SQLite (mahalliy tajriba uchun) va yig'ilgan statik fayllar.
# Yo'l BASE_DIR ga bog'langan, lekin qoida har ehtimolga qarshi keng.
*.sqlite3
backend/staticfiles/
backend/media/

